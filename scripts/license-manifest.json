  "issues": [
    {
      "id": "A01",
      "status": "resolved",
      "scopes": [
        "binary"
      ],
      "summary": "GPL SDK code linked with OpenSSL 1.1.1; no applicable exception verified",
      "resolution": "GPL production SDK implementations removed; native OpenSSL digest and RSA adapters plus BSD standard-library reader, exceptions and shared property table replace them. TestCIE GPL remains a separate test tool outside CIE ID.app. See scripts/replaced-legacy-sources.json and SDK replacement tests. OpenSSL is now 3.5.9 LTS under Apache-2.0; provider RSA import/recovery, static default/legacy providers, explicit ENGINE callback compatibility and TLS interoperability are tested."
    },
    {
      "id": "A02",
      "status": "resolved",
      "scopes": [
        "source",
        "binary"
      ],
      "summary": "RSAEURO permission terms for the embedded copy require verification or replacement",
      "resolution": "All ten RSAEURO source files removed from the current snapshot and build. RSA PKCS#1 recovery uses OpenSSL EVP_PKEY_verify_recover. Original hashes recorded in scripts/replaced-legacy-sources.json; publish a clean snapshot without old Git history."
    },
    {
      "id": "A03",
      "status": "resolved",
      "scopes": [
        "source",
        "binary"
      ],
      "summary": "Paul E. Jones SHA-1 permission for this embedded version requires verification or replacement",
      "resolution": "Paul E. Jones sha1.c and sha1.h removed. All SDK SHA-1 callers use the new BSD EVP digest adapter; SHA-224/256 PolarSSL implementation removed as well. Known-vector and CMS tests verify compatibility."
    },
    {
      "id": "A04",
      "status": "resolved",
      "scopes": [
        "binary"
      ],
      "summary": "Corresponding source/relinking materials and the FreeType alternative licence selection must be prepared for the released build",
      "resolution": "FreeType FTL selected. scripts/prepare-source-package.py collects exact corresponding application/library source, all 13 locked upstream source archives, build recipes and unsigned application fingerprints. Each binary distribution must carry its matching package and pass check-publication.py --release."
    }
  ],
